@* ============================================================================= *@
@* 1. CREATE FEEDBACK FORM VIEW (Create.cshtml snippet)                          *@
@* Place this inside Views/Feedback/Create.cshtml                                 *@
@* ============================================================================= *@

@model Day29WebSecurityFeedbackPortal.UserComment

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Feedback Security Lab</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #f4f6f9; padding: 20px;">

    <div style="max-width: 500px; margin: 40px auto; background-color: #fff; padding: 30px; border-radius: 8px; border: 1px solid #dee2e6; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h2 style="margin-top: 0; color: #212529;">Secure Feedback Portal</h2>
        <p style="font-size: 14px; color: #6c757d;">We strictly validate and encode inputs to block XSS and injection exploits.</p>
        
        <!-- Form wrapper utilizing post method and asp action routing -->
        <form asp-action="Create" method="post" style="margin-top: 20px;">
            
            <!-- CSRF protection token is injected automatically by ASP.NET Core inside our form -->
            
            <div style="margin-bottom: 15px;">
                <label asp-for="Name" style="font-weight: bold; color: #495057; display: block; margin-bottom: 5px;">Your Name:</label>
                <input asp-for="Name" style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box;" placeholder="Letters and spaces only" />
                <!-- Explicit validation error message span -->
                <span asp-validation-for="Name" style="color: #dc3545; font-size: 13px; display: block; margin-top: 5px;"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="CommentText" style="font-weight: bold; color: #495057; display: block; margin-bottom: 5px;">Your Feedback:</label>
                <textarea asp-for="CommentText" rows="4" style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box; resize: vertical;" placeholder="Type your comment..."></textarea>
                <!-- Explicit validation error message span -->
                <span asp-validation-for="CommentText" style="color: #dc3545; font-size: 13px; display: block; margin-top: 5px;"></span>
            </div>

            <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%;">
                Submit Secure Feedback
            </button>
        </form>
    </div>

    <!-- Client-side dynamic validation script bundles -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

@* ============================================================================= *@
