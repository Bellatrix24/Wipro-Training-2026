@model IEnumerable<EfCoreLibraryApp.DatabaseFirstModels.DbFirstBook>
@{
    ViewData["Title"] = "Database First Books";
}

<h2>Database First Books</h2>
<p class="text-muted">These books come from the Database First approach (simulated scaffolded models).</p>
<p><a asp-action="Create" class="btn btn-primary btn-sm">Add New Book</a></p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>ISBN</th>
            <th>Year</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.ISBN</td>
                <td>@book.PublishYear</td>
                <td>$@book.Price.ToString("F2")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.BookID" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.BookID" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
