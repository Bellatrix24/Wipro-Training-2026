@model IEnumerable<EfCoreLibraryApp.Models.Book>
@{
    ViewData["Title"] = "Books";
}

<h2>Books</h2>
<p><a asp-action="Create" class="btn btn-primary btn-sm">Add New Book</a></p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Genres</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author?.Name</td>
                <td>@string.Join(", ", book.BookGenres.Select(bg => bg.Genre?.Name))</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.BookID" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.BookID" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
