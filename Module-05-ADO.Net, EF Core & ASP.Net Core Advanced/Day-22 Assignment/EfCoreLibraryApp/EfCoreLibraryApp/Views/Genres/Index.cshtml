@model IEnumerable<EfCoreLibraryApp.Models.Genre>
@{
    ViewData["Title"] = "Genres";
}

<h2>Genres</h2>
<p><a asp-action="Create" class="btn btn-primary btn-sm">Add New Genre</a></p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@genre.GenreID" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@genre.GenreID" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
