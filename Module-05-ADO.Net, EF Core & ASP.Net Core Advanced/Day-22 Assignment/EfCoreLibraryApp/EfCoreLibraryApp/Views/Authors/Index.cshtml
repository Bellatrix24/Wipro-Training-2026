@model IEnumerable<EfCoreLibraryApp.Models.Author>
@{
    ViewData["Title"] = "Authors";
}

<h2>Authors</h2>
<p><a asp-action="Create" class="btn btn-primary btn-sm">Add New Author</a></p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Bio</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Name</td>
                <td>@author.Bio</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@author.AuthorID" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@author.AuthorID" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
