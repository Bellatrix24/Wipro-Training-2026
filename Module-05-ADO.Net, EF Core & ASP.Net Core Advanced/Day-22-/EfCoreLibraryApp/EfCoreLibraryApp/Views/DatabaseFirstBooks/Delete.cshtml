@model EfCoreLibraryApp.DatabaseFirstModels.DbFirstBook
@{
    ViewData["Title"] = "Delete Book (DB First)";
}

<h2>Delete Book (Database First)</h2>
<p>Are you sure you want to delete this book?</p>

<div class="card" style="max-width: 400px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text">ISBN: @Model.ISBN</p>
        <p class="card-text">Year: @Model.PublishYear | Price: $@Model.Price.ToString("F2")</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="BookID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
