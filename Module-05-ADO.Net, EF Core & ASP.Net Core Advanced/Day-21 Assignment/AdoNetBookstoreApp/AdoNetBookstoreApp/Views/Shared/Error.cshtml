@model AdoNetBookstoreApp.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Application Error</h1>
<h2 class="text-danger">An error occurred while executing a database action.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request Diagnostic ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        <strong>Error Details:</strong> @Model.ErrorMessage
    </div>
}

<div class="card mt-3">
    <div class="card-header bg-dark text-white">
        viva Tip
    </div>
    <div class="card-body">
        <p>If you encounter database connection errors, make sure you have executed the initialization scripts inside the <strong>DatabaseScripts/</strong> folder and set the correct connection string in <strong>appsettings.json</strong>.</p>
        <a href="/Books" class="btn btn-primary">Back to Catalog</a>
    </div>
</div>
