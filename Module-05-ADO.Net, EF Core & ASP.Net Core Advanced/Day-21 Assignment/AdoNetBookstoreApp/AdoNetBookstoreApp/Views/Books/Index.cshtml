@model IEnumerable<AdoNetBookstoreApp.Models.Book>
@{
    ViewData["Title"] = "Books Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Book Catalog (ADO.NET Reader)</h2>
    <a asp-action="Create" class="btn btn-primary">Add Book</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="alert alert-info py-2 small">
    <strong>ADO.NET Pipeline:</strong> This page retrieves books sequentially using <strong>SqlDataReader</strong> in a forward-only stream, ensuring maximum read performance.
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.BookId</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.ISBN</td>
                <td>$@book.Price.ToString("F2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
