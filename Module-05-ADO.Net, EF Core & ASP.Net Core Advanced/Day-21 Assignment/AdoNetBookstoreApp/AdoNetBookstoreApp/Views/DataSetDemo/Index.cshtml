@using System.Data
@model DataTable
@{
    ViewData["Title"] = "DataSet / DataTable Demo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Disconnected DataSet & DataTable Demo</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="alert alert-warning py-2 small">
    <strong>Disconnected Architecture:</strong> This page retrieves records into a disconnected <strong>DataSet</strong> using <strong>SqlDataAdapter</strong>. Changes are queued locally in a <strong>DataTable</strong> and synced back to the database in batches.
</div>

<div class="row">
    <div class="col-md-7">
        <h4>Books DataTable Rows</h4>
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th>Row Status</th>
                    <th>Book ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>ISBN</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in Model.Rows)
                {
                    <tr>
                        <td>
                            <span class="badge bg-success">Unchanged (DataSet)</span>
                        </td>
                        <td>@row["BookId"]</td>
                        <td>@row["Title"]</td>
                        <td>@row["Author"]</td>
                        <td>@row["ISBN"]</td>
                        <td>$@Convert.ToDecimal(row["Price"]).ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-5">
        <div class="card card-body bg-light">
            <h4>Disconnected Batch Addition</h4>
            <p class="small text-muted">Entering a book below adds a new row to the disconnected DataTable collection, then synchronizes it using a <strong>SqlDataAdapter</strong> batch write.</p>
            <form asp-controller="DataSetDemo" asp-action="ModifyDisconnected" method="post">
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">Title</label>
                    <input type="text" name="title" class="form-control form-control-sm" required />
                </div>
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">Author</label>
                    <input type="text" name="author" class="form-control form-control-sm" required />
                </div>
                <div class="form-group mb-2">
                    <label class="small font-weight-bold">ISBN</label>
                    <input type="text" name="isbn" class="form-control form-control-sm" required />
                </div>
                <div class="form-group mb-3">
                    <label class="small font-weight-bold">Price ($)</label>
                    <input type="number" step="0.01" name="price" class="form-control form-control-sm" value="19.99" required />
                </div>
                <button type="submit" class="btn btn-warning btn-sm w-100">Add & Synchronize Row</button>
            </form>
        </div>
    </div>
</div>
