@model IEnumerable<AdvancedLibraryManagementSystem.Models.Book>
@{
    ViewData["Title"] = "Books";
}

<h2>Books</h2>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="title" value="@ViewBag.Title" class="form-control" placeholder="Search title..." />
    </div>
    <div class="col-auto">
        <select name="authorId" class="form-select">
            <option value="">All Authors</option>
            @foreach (var a in (IEnumerable<AdvancedLibraryManagementSystem.Models.Author>)ViewBag.Authors)
            {
                <option value="@a.AuthorID" selected="@(ViewBag.AuthorId == a.AuthorID)">@a.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="genreId" class="form-select">
            <option value="">All Genres</option>
            @foreach (var g in (IEnumerable<AdvancedLibraryManagementSystem.Models.Genre>)ViewBag.Genres)
            {
                <option value="@g.GenreID" selected="@(ViewBag.GenreId == g.GenreID)">@g.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="sortOrder" class="form-select">
            <option value="">Title A-Z</option>
            <option value="title_desc" selected="@(ViewBag.SortOrder == "title_desc")">Title Z-A</option>
            <option value="year" selected="@(ViewBag.SortOrder == "year")">Year Old-New</option>
            <option value="year_desc" selected="@(ViewBag.SortOrder == "year_desc")">Year New-Old</option>
            <option value="price" selected="@(ViewBag.SortOrder == "price")">Price Low-High</option>
            <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Price High-Low</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
    </div>
</form>

<button class="btn btn-primary btn-sm mb-3" onclick="loadForm('/Books/Create', 'Add Book')">Add Book</button>

<table class="table table-bordered table-sm">
    <thead class="table-light">
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Year</th>
            <th>Price</th>
            <th>Genres</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="booksTable">
        @foreach (var book in Model)
        {
            <tr id="book-@book.BookID">
                <td>@book.Title</td>
                <td>@book.Author?.Name</td>
                <td>@book.PublishYear</td>
                <td>$@book.Price.ToString("F2")</td>
                <td>@string.Join(", ", book.BookGenres.Select(bg => bg.Genre?.Name))</td>
                <td>
                    <button class="btn btn-warning btn-sm" onclick="loadForm('/Books/Edit/@book.BookID', 'Edit Book')">Edit</button>
                    <button class="btn btn-danger btn-sm" onclick="deleteItem('/Books/Delete/@book.BookID', 'book-@book.BookID')">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex gap-2">
    @if (ViewBag.CurrentPage > 1)
    {
        <a asp-action="Index" 
           asp-route-page="@(ViewBag.CurrentPage - 1)" 
           asp-route-title="@ViewBag.Title"
           asp-route-authorId="@ViewBag.AuthorId"
           asp-route-genreId="@ViewBag.GenreId"
           asp-route-sortOrder="@ViewBag.SortOrder"
           class="btn btn-outline-secondary btn-sm">Previous</a>
    }
    @if (Model.Count() == ViewBag.PageSize)
    {
        <a asp-action="Index"
           asp-route-page="@(ViewBag.CurrentPage + 1)"
           asp-route-title="@ViewBag.Title"
           asp-route-authorId="@ViewBag.AuthorId"
           asp-route-genreId="@ViewBag.GenreId"
           asp-route-sortOrder="@ViewBag.SortOrder"
           class="btn btn-outline-secondary btn-sm">Next</a>
    }
</div>
