@model AdvancedLibraryManagementSystem.Models.Book

@{
    var isEdit = Model.BookID != 0;
    var action = isEdit ? "Edit" : "Create";
    var selectedGenres = ViewBag.SelectedGenres as List<int> ?? new List<int>();
}

<form id="bookForm" asp-controller="Books" asp-action="@action" method="post">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="BookID" />
    }
    <div class="mb-2">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="AuthorID" class="form-label">Author</label>
        <select asp-for="AuthorID" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var a in (IEnumerable<AdvancedLibraryManagementSystem.Models.Author>)ViewBag.Authors)
            {
                <option value="@a.AuthorID">@a.Name</option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="PublishYear" class="form-label">Publish Year</label>
        <input asp-for="PublishYear" class="form-control" type="number" />
    </div>
    <div class="mb-2">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-2">
        <label class="form-label">Genres</label>
        @foreach (var g in (IEnumerable<AdvancedLibraryManagementSystem.Models.Genre>)ViewBag.Genres)
        {
            <div class="form-check">
                <input type="checkbox" name="selectedGenres" value="@g.GenreID" class="form-check-input"
                       @(selectedGenres.Contains(g.GenreID) ? "checked" : "") />
                <label class="form-check-label">@g.Name</label>
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Save</button>
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
</form>
