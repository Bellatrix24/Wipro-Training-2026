@model IEnumerable<SecureTaskManagementPlatform.Models.TaskItem>
@{
    ViewData["Title"] = "My Tasks";
    var canEdit = User.HasClaim("CanEditTask", "true");
}

<div class="row mt-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>My Tasks Dashboard</h2>
            <a asp-controller="Tasks" asp-action="Create" class="btn btn-primary btn-sm">Create New Task</a>
        </div>
        <p class="text-muted">Welcome, <strong>@ViewBag.UserFullName</strong>. Below is the list of your active tasks.</p>

        @if (!canEdit)
        {
            <div class="alert alert-warning py-2 small">
                <strong>Notice:</strong> Your account does not have the <code>CanEditTask</code> claim. You can view task details, but editing tasks will result in Access Denied.
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                You have no tasks assigned. Click "Create New Task" to add your first task!
            </div>
        }
        else
        {
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@Html.DisplayFor(modelItem => item.Title)</strong></td>
                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                            <td>@item.DueDate.ToString("dd-MMM-yyyy")</td>
                            <td>
                                @if (item.IsCompleted)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Tasks" asp-action="Details" asp-route-id="@item.TaskId" class="btn btn-info btn-sm">Details</a>
                                @if (canEdit)
                                {
                                    <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@item.TaskId" class="btn btn-warning btn-sm">Edit</a>
                                }
                                else
                                {
                                    <button class="btn btn-warning btn-sm" disabled title="No editing claim">Edit 🔒</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
