@{
    ViewData["Title"] = "Database Administration";
}

<div class="row mt-4">
    <div class="col-md-12">
        <h2>Database Administration Dashboard</h2>
        <p class="text-muted">Restricted resources visible to administrative users holding the <strong>Admin</strong> role claim.</p>

        <div class="row mt-4">
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-header bg-dark text-white">Database Parameters</div>
                    <div class="card-body">
                        <ul class="mb-0 small">
                            <li><strong>Active Database Context:</strong> EF Core Entity Framework</li>
                            <li><strong>Provider:</strong> Microsoft.EntityFrameworkCore.InMemory</li>
                            <li><strong>Connection String Protection:</strong> Secured in Configuration (appsettings)</li>
                            <li><strong>SSL/TLS Database Connections:</strong> Forced at transport layer</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-header bg-danger text-white">System Security Stats</div>
                    <div class="card-body">
                        <ul class="mb-0 small">
                            <li><strong>SQL Injection Risk:</strong> Zero (all queries use parameterization)</li>
                            <li><strong>Brute Force Status:</strong> Locked out accounts after 5 failures enabled</li>
                            <li><strong>HMAC Key Status:</strong> Active and cryptographically sound</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-3">
            <a asp-controller="Audit" asp-action="Logs" class="btn btn-danger btn-sm">Open Audit Trail Logs</a>
        </div>
    </div>
</div>
