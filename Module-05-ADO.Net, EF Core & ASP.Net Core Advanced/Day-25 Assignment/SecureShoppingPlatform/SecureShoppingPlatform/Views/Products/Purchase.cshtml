@model PurchaseViewModel
@{
    ViewData["Title"] = "Purchase";
}

<h2>Purchase Product</h2>

<div class="mb-3">
    <strong>@Model.Product?.Name</strong><br />
    Price: @Model.Product?.Price.ToString("C")<br />
    Available: @Model.Product?.Stock
</div>

<form asp-action="Purchase" method="post" class="col-md-5">
    <input type="hidden" asp-for="ProductId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ShippingAddress" class="form-label"></label>
        <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Place Order</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
