@model TaskViewModel
@{
    ViewData["Title"] = "Create Task";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h2 class="mb-3 text-center">Create New Task</h2>
        
        <form asp-action="Create" method="post" class="border p-4 bg-white rounded shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Task Title</label>
                <input asp-for="Title" class="form-control" placeholder="Enter task title" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter description..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate" class="form-label">Due Date</label>
                <input asp-for="DueDate" class="form-control" type="date" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50">Create Task</button>
                <a href="/" class="btn btn-secondary w-50 text-center">Cancel</a>
            </div>
        </form>
    </div>
</div>
