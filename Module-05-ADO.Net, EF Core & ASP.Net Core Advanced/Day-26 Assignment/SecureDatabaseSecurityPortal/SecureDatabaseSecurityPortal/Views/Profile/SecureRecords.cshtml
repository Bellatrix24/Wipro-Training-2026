@model IEnumerable<SecureDatabaseSecurityPortal.Controllers.CustomerRecordViewModel>
@{
    ViewData["Title"] = "Secure Customer Records";
}

<div class="row mt-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Secure Customer Records</h2>
        </div>
        <p class="text-muted small">Below is the decrypted database list. Every record's sensitive <code>TaxId</code> is verified against its <code>TaxIdHmac</code> signature upon retrieval to ensure integrity.</p>

        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Customer Name</th>
                    <th>Email address</th>
                    <th>Phone</th>
                    <th>Decrypted Sensitive Tax ID</th>
                    <th>Integrity State</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.FullName</strong></td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>
                            @if (item.IsTampered)
                            {
                                <span class="text-danger font-weight-bold">@item.TaxId</span>
                            }
                            else
                            {
                                <code class="text-success">@item.TaxId</code>
                            }
                        </td>
                        <td>
                            @if (item.IsTampered)
                            {
                                <span class="badge bg-danger">TAMPER DETECTED / FAIL</span>
                            }
                            else
                            {
                                <span class="badge bg-success">SECURE / VERIFIED</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <div class="alert alert-light border mt-4 small">
            <h6>Defensive Architecture Notes:</h6>
            <ul class="mb-0 text-muted">
                <li><strong>Encryption:</strong> Tax IDs are encrypted in database storage using AES symmetric keys.</li>
                <li><strong>HMAC Signature:</strong> Calculated via SHA-256 using a separate secure server key. Retrying to modify value in Database without regenerating the HMAC will immediately trigger the tamper detection alert and audit logs.</li>
            </ul>
        </div>
    </div>
</div>
