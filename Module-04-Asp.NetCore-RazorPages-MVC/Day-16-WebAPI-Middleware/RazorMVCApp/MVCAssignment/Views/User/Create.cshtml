@model MVCAssignment.Models.User
@{
    ViewData["Title"] = "Create User Profile";
}

@* Natural comment: Form page to create a User. Demonstrates simple and nested address binding. *@
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create User Profile</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        
                        <h5 class="text-primary mb-3">Basic Information</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label font-weight-bold"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label font-weight-bold"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Age" class="form-label font-weight-bold"></label>
                            <input asp-for="Age" class="form-control" type="number" placeholder="Enter age" />
                            <span asp-validation-for="Age" class="text-danger"></span>
                        </div>

                        <hr class="my-4" />
                        <h5 class="text-primary mb-3">Address Details (Nested Complex Model)</h5>

                        <div class="mb-3">
                            <label asp-for="Address.Street" class="form-label font-weight-bold"></label>
                            <input asp-for="Address.Street" class="form-control" placeholder="123 Main St" />
                            <span asp-validation-for="Address.Street" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Address.City" class="form-label font-weight-bold"></label>
                                <input asp-for="Address.City" class="form-control" placeholder="Enter city" />
                                <span asp-validation-for="Address.City" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Address.ZipCode" class="form-label font-weight-bold"></label>
                                <input asp-for="Address.ZipCode" class="form-control" placeholder="12345" />
                                <span asp-validation-for="Address.ZipCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Home</a>
                            <button type="submit" class="btn btn-primary">Submit Profile</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
