@page
@model ErrorModel
@{
    ViewData["Title"] = "Application Error";
}

@* Natural comment: Customized error page for the custom exception handling middleware demonstration. *@
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">Unhandled Exception Detected</h3>
                </div>
                <div class="card-body text-center p-5">
                    <div class="text-danger mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                    </div>
                    
                    <h2 class="text-danger mb-3">Oops! Something went wrong.</h2>
                    <p class="lead text-secondary mb-4">
                        Our application's exception handling middleware caught an unhandled request issue. 
                        A custom error page has been served successfully to the browser.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-secondary py-2 my-3 d-inline-block">
                            <strong>Diagnostic Trace ID:</strong> <code>@Model.RequestId</code>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-page="/Index" class="btn btn-primary">Return to Homepage</a>
                        <a asp-page="/Items/Index" class="btn btn-outline-success">View Items Catalog</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
