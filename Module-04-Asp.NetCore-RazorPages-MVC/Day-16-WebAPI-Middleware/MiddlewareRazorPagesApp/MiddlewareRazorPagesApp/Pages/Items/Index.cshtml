@page
@model MiddlewareRazorPagesApp.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Items List";
}

@* Natural comment: Items list view page. Uses a foreach loop to render each item. *@
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dynamic Items Catalog</h2>
        <a asp-page="/Items/Create" class="btn btn-success">Add New Item</a>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-info">
            No items have been created yet. Click "Add New Item" to populate the list!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-left">
                        <div class="card-body">
                            <h4 class="card-title text-success">@item.Name</h4>
                            <hr />
                            <p class="card-text text-secondary">@item.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
