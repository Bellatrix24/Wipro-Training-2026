@page
@{
    ViewData["Title"] = "Registration Success";
}

@* Natural comment: Simple success page rendered when the registration validation succeeds. *@
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Registration Successful!</h4>
                </div>
                <div class="card-body p-5">
                    <div class="text-success mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                        </svg>
                    </div>
                    <h2>Congratulations!</h2>
                    <p class="lead text-secondary my-3">
                        Your account has been registered successfully. All client-side and server-side validation checks passed!
                    </p>
                    <div class="mt-4">
                        <a asp-page="/Index" class="btn btn-primary">Return Home</a>
                        <a asp-page="/Registration/Create" class="btn btn-outline-primary">Register Another Account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
