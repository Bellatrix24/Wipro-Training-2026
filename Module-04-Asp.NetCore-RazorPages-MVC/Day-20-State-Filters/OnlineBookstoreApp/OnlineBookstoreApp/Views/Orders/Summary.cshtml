@model IEnumerable<OnlineBookstoreApp.Models.CartItem>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Order Summary";
    var username = Context.Session.GetString("Username");
}

<h2>Checkout Order Summary</h2>
<p class="text-muted">Verify your purchase selections and enter your billing details to submit your order.</p>

<div class="row">
    <div class="col-md-7">
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Book.Title</td>
                        <td>$@item.Book.Price.ToString("F2")</td>
                        <td>@item.Quantity</td>
                        <td>$@((item.Book.Price * item.Quantity).ToString("F2"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                    <td><strong>$@ViewBag.Total.ToString("F2")</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="col-md-5 mt-3 mt-md-0">
        <div class="card card-body bg-light">
            <h4>Billing & Delivery</h4>
            <form method="post" action="/Orders/PlaceOrder">
                <div class="mb-3">
                    <label for="customerName" class="form-label">Recipient Name</label>
                    <input type="text" id="customerName" name="customerName" class="form-control" value="@username" required />
                </div>

                <button type="submit" class="btn btn-success w-100">Place Order</button>
                <a href="/Cart" class="btn btn-secondary w-100 mt-2">Back to Cart</a>
            </form>
        </div>
    </div>
</div>
