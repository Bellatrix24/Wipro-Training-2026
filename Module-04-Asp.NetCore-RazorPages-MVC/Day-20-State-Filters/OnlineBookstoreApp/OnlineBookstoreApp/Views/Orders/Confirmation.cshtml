@model OnlineBookstoreApp.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="alert alert-success mt-3 text-center">
    <h2>Purchase Completed Successfully!</h2>
    <p>Thank you for your business. Your order ID is <strong>#@Model.Id</strong>.</p>
</div>

<div class="card mt-4" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header bg-success text-white font-weight-bold">
        Simulated Order Invoice
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <strong>Recipient:</strong> @Model.CustomerName
            </div>
            <div class="col-sm-6 text-sm-end">
                <strong>Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")
            </div>
        </div>

        <hr />
        <h5>Purchased Items</h5>
        <table class="table table-bordered table-sm mt-2">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Book.Title</td>
                        <td>@item.Book.Author</td>
                        <td>$@item.Book.Price.ToString("F2")</td>
                        <td>@item.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end mt-3">
            <h4>Total Paid: <span class="text-success">$@Model.TotalAmount.ToString("F2")</span></h4>
        </div>

        <hr />
        <div class="text-center">
            <a href="/Books" class="btn btn-primary">Return to Book Catalog</a>
        </div>
    </div>
</div>
