@model IEnumerable<OnlineBookstoreApp.Models.Book>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Books Catalog";
    var role = Context.Session.GetString("Role");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Book Catalog</h2>
    @if (role == "Admin")
    {
        <a href="/Inventory/Add" class="btn btn-warning">Add New Book (Admin)</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.ISBN</td>
                <td>$@book.Price.ToString("F2")</td>
                <td>
                    <a href="/Books/Details/@book.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <a href="/Cart/Add/@book.Id" class="btn btn-sm btn-primary">Add to Cart</a>
                    
                    @if (role == "Admin")
                    {
                        <a href="/Inventory/Edit/@book.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a href="/Inventory/Delete/@book.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
