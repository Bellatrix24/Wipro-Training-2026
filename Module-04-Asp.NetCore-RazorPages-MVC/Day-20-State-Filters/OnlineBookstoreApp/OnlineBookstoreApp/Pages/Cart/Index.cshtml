@page
@model OnlineBookstoreApp.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Your Shopping Cart</h2>
<p class="text-muted">Managed inside your session. Persists across requests dynamically.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

@if (Model.CartItems.Any())
{
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CartItems)
            {
                <tr>
                    <td>@item.Book.Title</td>
                    <td>@item.Book.Author</td>
                    <td>$@item.Book.Price.ToString("F2")</td>
                    <td>@item.Quantity</td>
                    <td>$@((item.Book.Price * item.Quantity).ToString("F2"))</td>
                    <td>
                        <a asp-page="/Cart/Remove" asp-route-id="@item.Book.Id" class="btn btn-sm btn-danger">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4" class="text-end"><strong>Total Amount:</strong></td>
                <td colspan="2"><strong>$@Model.TotalAmount.ToString("F2")</strong></td>
            </tr>
        </tfoot>
    </table>

    <div class="mt-3">
        <a href="/Books" class="btn btn-secondary">Continue Shopping</a>
        <a href="/Orders/Summary" class="btn btn-success">Proceed to Checkout</a>
    </div>
}
else
{
    <div class="card card-body bg-light mt-3 text-center">
        <p>Your shopping cart is currently empty.</p>
        <div>
            <a href="/Books" class="btn btn-primary">Browse Catalog</a>
        </div>
    </div>
}
