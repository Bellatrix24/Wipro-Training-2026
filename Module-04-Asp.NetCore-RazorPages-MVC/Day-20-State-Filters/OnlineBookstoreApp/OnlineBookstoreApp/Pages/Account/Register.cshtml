@page
@model OnlineBookstoreApp.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h2>User Registration</h2>
<p class="text-muted">Register a new in-memory user account and select your access role (Admin or Customer).</p>

<div class="row">
    <div class="col-md-6">
        <div class="card card-body bg-light mt-3">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="UserAccount.Username" class="form-label"></label>
                    <input asp-for="UserAccount.Username" class="form-control" placeholder="Enter username" />
                    <span asp-validation-for="UserAccount.Username" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="UserAccount.Password" class="form-label"></label>
                    <input asp-for="UserAccount.Password" class="form-control" type="password" placeholder="Enter password" />
                    <span asp-validation-for="UserAccount.Password" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="UserAccount.Role" class="form-label"></label>
                    <select asp-for="UserAccount.Role" class="form-select">
                        <option value="Customer">Customer (Standard User)</option>
                        <option value="Admin">Admin (Can edit/add/delete books)</option>
                    </select>
                    <span asp-validation-for="UserAccount.Role" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Register Account</button>
                <a asp-page="/Account/Login" class="btn btn-link">Already have an account? Login here</a>
            </form>
        </div>
    </div>
</div>
