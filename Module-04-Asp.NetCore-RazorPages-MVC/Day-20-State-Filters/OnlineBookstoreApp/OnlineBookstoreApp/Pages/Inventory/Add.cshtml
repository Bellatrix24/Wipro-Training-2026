@page
@model OnlineBookstoreApp.Pages.Inventory.AddModel
@{
    ViewData["Title"] = "Add Book";
}

<h2>Add New Book to Inventory</h2>
<p class="text-muted">Protected by AuthFilter and RoleFilter. Only users with the Admin role can access this page.</p>

<div class="row">
    <div class="col-md-6">
        <div class="card card-body bg-light mt-3">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Book.Title" class="form-label"></label>
                    <input asp-for="Book.Title" class="form-control" placeholder="Enter book title" />
                    <span asp-validation-for="Book.Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Book.Author" class="form-label"></label>
                    <input asp-for="Book.Author" class="form-control" placeholder="Enter author name" />
                    <span asp-validation-for="Book.Author" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Book.ISBN" class="form-label"></label>
                    <input asp-for="Book.ISBN" class="form-control" placeholder="e.g. 978-0-13-449416-6" />
                    <span asp-validation-for="Book.ISBN" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Book.Price" class="form-label"></label>
                    <input asp-for="Book.Price" class="form-control" type="number" step="0.01" value="19.99" />
                    <span asp-validation-for="Book.Price" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Add Book</button>
                <a href="/Books" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
