@model MVCAssignment.Models.User
@{
    ViewData["Title"] = "Submission Result";
}

@* Natural comment: Result view to show the successfully bound and validated form data. *@
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Form Submission Successful!</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-success mb-3">Submitted User Data</h5>
                    
                    <div class="row mb-3">
                        <div class="col-sm-4 font-weight-bold text-muted">Full Name:</div>
                        <div class="col-sm-8"><strong>@Model.FirstName @Model.LastName</strong></div>
                    </div>
                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-4 font-weight-bold text-muted">Age:</div>
                        <div class="col-sm-8">@Model.Age years old</div>
                    </div>
                    <hr />

                    <h5 class="text-success mt-4 mb-3">Submitted Address (Nested Model)</h5>

                    <div class="row mb-3">
                        <div class="col-sm-4 font-weight-bold text-muted">Street:</div>
                        <div class="col-sm-8">@Model.Address.Street</div>
                    </div>
                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-4 font-weight-bold text-muted">City:</div>
                        <div class="col-sm-8">@Model.Address.City</div>
                    </div>
                    <hr />

                    <div class="row mb-4">
                        <div class="col-sm-4 font-weight-bold text-muted">Zip Code:</div>
                        <div class="col-sm-8">@Model.Address.ZipCode</div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Create" class="btn btn-outline-success">Create Another Profile</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-success">Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
