@page "/Products/{id:int}"
@model RazorPagesAssignment.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Product Details - " + (Model.Product != null ? Model.Product.Name : "Product");
}

@* Natural comment: Details view page displaying product information. Uses a custom route: /Products/{id} *@
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Product Details</h4>
                </div>
                <div class="card-body">
                    @if (Model.Product != null)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3 font-weight-bold text-muted">Product ID:</div>
                            <div class="col-sm-9">@Model.Product.ProductID</div>
                        </div>
                        <hr />

                        <div class="row mb-3">
                            <div class="col-sm-3 font-weight-bold text-muted">Name:</div>
                            <div class="col-sm-9"><strong>@Model.Product.Name</strong></div>
                        </div>
                        <hr />

                        <div class="row mb-3">
                            <div class="col-sm-3 font-weight-bold text-muted">Description:</div>
                            <div class="col-sm-9">@Model.Product.Description</div>
                        </div>
                        <hr />

                        <div class="row mb-4">
                            <div class="col-sm-3 font-weight-bold text-muted">Associated Categories:</div>
                            <div class="col-sm-9">
                                @if (Model.Product.Categories != null && Model.Product.Categories.Any())
                                {
                                    foreach (var category in Model.Product.Categories)
                                    {
                                        <span class="badge bg-secondary me-1">@category.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted italic">None</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger my-3">
                            Product details could not be loaded because the product is invalid or not found.
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="/Products/Index" class="btn btn-outline-secondary">Back to List</a>
                        <a asp-page="/Products/Create" class="btn btn-success">Add Another Product</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
