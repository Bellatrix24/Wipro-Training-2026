@model IEnumerable<BankAccount>
@{
    ViewData["Title"] = "Admin Portal";
}

<h2>Administrative Portal - User Account Registry</h2>
<div class="alert alert-success mt-3">
    <strong>Authorized:</strong> Gained access to administrative bank console via RoleAuthorizationFilter verification!
</div>

<p class="text-muted">A full registry of customer balances stored inside the system memory.</p>

<table class="table table-striped table-bordered mt-3">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Account Number</th>
            <th>Type</th>
            <th>Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var acc in Model)
        {
            <tr>
                <td><strong>@acc.OwnerName</strong></td>
                <td>@acc.AccountNumber</td>
                <td>@acc.AccountType</td>
                <td>$@acc.Balance.ToString("F2")</td>
            </tr>
        }
    </tbody>
</table>

<a href="/Products" class="btn btn-secondary">Back to Products</a>
