@using MvcFiltersBankingStoreApp.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Filters Banking Store App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Products" asp-action="Index">FiltersBankingStoreApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Products" asp-action="Index">Catalog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Orders/Checkout?loggedIn=true">Checkout Demo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Banking/Accounts?loggedIn=true">Bank Accounts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Admin/Users?loggedIn=true&role=admin">Admin Users</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container mb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        
        <!-- Live Diagnostic Logging Console to demonstrate filters -->
        <hr class="my-5" />
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white font-weight-bold">
                        Request Logging Filter Console
                    </div>
                    <div class="card-body bg-light" style="max-height: 250px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
                        @if (LoggingService.RequestLogs.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var log in LoggingService.RequestLogs.AsEnumerable().Reverse())
                                {
                                    <li>@log</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">No request logs recorded yet.</span>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white font-weight-bold">
                        User Action Logging Filter Console
                    </div>
                    <div class="card-body bg-light" style="max-height: 250px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
                        @if (LoggingService.UserActionLogs.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var log in LoggingService.UserActionLogs.AsEnumerable().Reverse())
                                {
                                    <li>@log</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">No user action logs recorded yet.</span>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white font-weight-bold">
                        Exception Logging Filter Console
                    </div>
                    <div class="card-body bg-light" style="max-height: 250px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
                        @if (LoggingService.ExceptionLogs.Any())
                        {
                            <ul class="list-unstyled text-danger">
                                @foreach (var log in LoggingService.ExceptionLogs.AsEnumerable().Reverse())
                                {
                                    <li>@log</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">No exceptions recorded yet.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted bg-light py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - MvcFiltersBankingStoreApp - Student Internship Submission
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
