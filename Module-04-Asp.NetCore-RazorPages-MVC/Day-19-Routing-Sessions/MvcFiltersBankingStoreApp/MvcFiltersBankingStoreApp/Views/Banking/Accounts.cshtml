@model IEnumerable<BankAccount>
@{
    ViewData["Title"] = "Bank Accounts";
}

<h2>Online Banking Accounts</h2>
<p class="text-muted">Protected by SimpleAuthenticationFilter. All ledger listings are simulated via in-memory collections.</p>

<div class="row mt-3">
    <div class="col-md-12">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Account Number</th>
                    <th>Account Type</th>
                    <th>Owner</th>
                    <th>Current Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var acc in Model)
                {
                    <tr>
                        <td>@acc.AccountNumber</td>
                        <td>@acc.AccountType</td>
                        <td>@acc.OwnerName</td>
                        <td>$@acc.Balance.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a href="/Banking/Transfer?loggedIn=true" class="btn btn-primary">Transfer Funds</a>
    <a href="/Banking/Transactions?loggedIn=true" class="btn btn-secondary">View Transaction History</a>
</div>
