@model IEnumerable<Transaction>
@{
    ViewData["Title"] = "Transaction History";
}

<h2>Transaction History Ledger</h2>
<p class="text-muted">A listing of all transactions processed during the current session.</p>

<div class="row mt-3">
    <div class="col-md-12">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Account Number</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Timestamp</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Id</td>
                        <td>@t.AccountNumber</td>
                        <td>@t.Type</td>
                        <td>$@t.Amount.ToString("F2")</td>
                        <td>@t.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@t.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a href="/Banking/Accounts?loggedIn=true" class="btn btn-secondary">Back to Accounts</a>
</div>
