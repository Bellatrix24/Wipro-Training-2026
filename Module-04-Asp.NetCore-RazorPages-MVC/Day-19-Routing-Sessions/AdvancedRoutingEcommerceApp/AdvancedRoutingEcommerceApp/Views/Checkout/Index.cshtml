@{
    ViewData["Title"] = "Checkout";
}

<div class="checkout-container glass-card">
    <div class="checkout-header">
        <h2>Secure Checkout</h2>
        <span class="security-tag">SSL Encrypted Session</span>
    </div>
    
    <div class="checkout-split-layout">
        <div class="checkout-form-section">
            <h3>Shipping and Billing Address</h3>
            <form class="checkout-form" onsubmit="alert('Purchase completed successfully!'); return false;">
                <div class="form-row">
                    <div class="form-group-premium">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" value="John Doe" required />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group-premium">
                        <label for="address">Address</label>
                        <input type="text" id="address" value="123 Main Street" required />
                    </div>
                </div>
                <div class="form-row-grid">
                    <div class="form-group-premium">
                        <label for="city">City</label>
                        <input type="text" id="city" value="Metropolis" required />
                    </div>
                    <div class="form-group-premium">
                        <label for="zipCode">Zip Code</label>
                        <input type="text" id="zipCode" value="10001" required />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group-premium">
                        <label for="cardNumber">Credit Card</label>
                        <input type="text" id="cardNumber" placeholder="0000-0000-0000-0000" required />
                    </div>
                </div>
                <button type="submit" class="btn-primary-premium w-100">Complete Purchase</button>
            </form>
        </div>

        <div class="order-summary-section">
            <h3>Order Summary</h3>
            <div class="summary-details">
                <div class="summary-line">
                    <span>Selected Category Items</span>
                    <span>$1,200.00</span>
                </div>
                <div class="summary-line">
                    <span>Shipping and Handling</span>
                    <span>Free</span>
                </div>
                <div class="summary-line border-top-total">
                    <strong>Total Amount</strong>
                    <strong class="price-val">$1,200.00</strong>
                </div>
            </div>
        </div>
    </div>
</div>
