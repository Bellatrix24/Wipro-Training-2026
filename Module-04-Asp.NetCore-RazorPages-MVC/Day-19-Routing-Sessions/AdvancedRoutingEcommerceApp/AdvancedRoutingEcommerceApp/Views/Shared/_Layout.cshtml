<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Advanced Routing E-Commerce</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdvancedRoutingEcommerceApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark container">
            <a class="navbar-brand-premium" asp-controller="Products" asp-action="Index">AdvancedRoutingEcommerce</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse justify-content-end">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link-premium" asp-controller="Products" asp-action="Index">Catalog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-premium" asp-controller="Dashboard" asp-action="Index" asp-route-role="user">User Panel</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-premium" asp-controller="Dashboard" asp-action="Index" asp-route-role="admin">Admin Panel</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-premium" asp-controller="Checkout" asp-action="Index" asp-route-loggedIn="false">Checkout Demo</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container my-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <span>&copy; 2026 - AdvancedRoutingEcommerceApp - Designed with ASP.NET Core MVC</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
